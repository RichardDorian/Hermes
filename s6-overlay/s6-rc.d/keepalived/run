#!/command/with-contenv sh

if [ "$ENABLE_KEEPALIVED" != "true" ]; then
  echo "ENABLE_KEEPALIVED=$ENABLE_KEEPALIVED, not starting keepalived"
  # Mark the service down so s6 does not restart it
  exec /command/s6-svc -Od .
fi

# keepalived only accepts a prefix length, convert WAN_NETMASK (e.g. 255.255.255.0 -> 24)
WAN_PREFIX=0
for octet in $(echo "$WAN_NETMASK" | tr . ' '); do
  while [ "$octet" -gt 0 ]; do
    WAN_PREFIX=$((WAN_PREFIX + (octet & 1)))
    octet=$((octet >> 1))
  done
done
export WAN_PREFIX

# keepalived cannot apply its VMAC sysctls inside a container, set them here: only
# answer ARP for an address on the interface holding it, so KEEPALIVED_VIP always
# resolves to the virtual MAC rather than the one of LAN_IF
for sysctl in arp_ignore arp_announce; do
  path="/proc/sys/net/ipv4/conf/all/$sysctl"
  if [ "$(cat "$path")" = "1" ]; then
    echo "net.ipv4.conf.all.$sysctl already set to 1"
  elif [ -w "$path" ]; then
    echo 1 > "$path"
    echo "net.ipv4.conf.all.$sysctl set to 1"
  else
    echo "Cannot write to $path, set net.ipv4.conf.all.$sysctl=1 on the container (e.g. --sysctl)" \
      "or clients may resolve $KEEPALIVED_VIP to the MAC of $LAN_IF" >&2
  fi
done

# Configure keepalived based on environment variables
envsubst < /etc/keepalived/keepalived.conf.template > /etc/keepalived/keepalived.conf

echo "Starting keepalived"
exec keepalived --dont-fork --log-console --vrrp --use-file /etc/keepalived/keepalived.conf
