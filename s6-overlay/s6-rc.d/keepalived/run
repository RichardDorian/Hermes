#!/command/with-contenv sh

if [ "$ENABLE_KEEPALIVED" != "true" ]; then
  echo "ENABLE_KEEPALIVED=$ENABLE_KEEPALIVED, not starting keepalived"
  # Mark the service down so s6 does not restart it
  exec /command/s6-svc -Od .
fi

# keepalived only accepts a prefix length, convert WAN_NETMASK (e.g. 255.255.255.0 -> 24)
WAN_PREFIX=0
for octet in $(echo "$WAN_NETMASK" | tr . ' '); do
  while [ "$octet" -gt 0 ]; do
    WAN_PREFIX=$((WAN_PREFIX + (octet & 1)))
    octet=$((octet >> 1))
  done
done
export WAN_PREFIX

# Set a sysctl, or explain how to when /proc/sys is read-only
set_sysctl() {
  path="/proc/sys/$(echo "$1" | tr . /)"
  if [ "$(cat "$path")" = "$2" ]; then
    echo "$1 already set to $2"
  elif [ -w "$path" ]; then
    echo "$2" > "$path"
    echo "$1 set to $2"
  else
    echo "Cannot write to $path, set $1=$2 on the container (e.g. --sysctl): $3" >&2
  fi
}

# keepalived cannot apply its VMAC sysctls inside a container, set them here

# Only answer ARP for an address on the interface holding it
for sysctl in arp_ignore arp_announce; do
  set_sysctl "net.ipv4.conf.all.$sysctl" 1 "clients may resolve $KEEPALIVED_VIP to the MAC of $LAN_IF"
done

# Clients reach KEEPALIVED_VIP through the VMAC interface while the route back to
# them goes through LAN_IF, so strict reverse path filtering would drop their
# traffic. Loosen it before keepalived creates the VMAC interface from "default"
for conf in all default; do
  if [ "$(cat "/proc/sys/net/ipv4/conf/$conf/rp_filter")" = "1" ]; then
    set_sysctl "net.ipv4.conf.$conf.rp_filter" 2 "traffic from clients to $KEEPALIVED_VIP will be dropped"
  fi
done

# Configure keepalived based on environment variables
envsubst < /etc/keepalived/keepalived.conf.template > /etc/keepalived/keepalived.conf

echo "Starting keepalived"
exec keepalived --dont-fork --log-console --vrrp --use-file /etc/keepalived/keepalived.conf
