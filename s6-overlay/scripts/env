#!/command/with-contenv sh

# Required variables have no default, the Containerfile declares them empty
required="WAN_ADDRESS WAN_GATEWAY"
if [ "$ENABLE_KEEPALIVED" = "true" ]; then
  required="$required KEEPALIVED_VIP"
fi

missing=0
for name in $required; do
  eval "value=\$$name"
  if [ -z "$value" ]; then
    echo "$name is required" >&2
    missing=1
  fi
done

# DHCP_STATIC_LEASES maps MAC addresses to IP addresses
if ! echo "$DHCP_STATIC_LEASES" | jq -e 'type == "object" and all(.[]; type == "string")' >/dev/null 2>&1; then
  echo "DHCP_STATIC_LEASES must be a JSON object of MAC address to IP address strings" >&2
  missing=1
fi

exit $missing
