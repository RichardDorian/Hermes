#!/command/with-contenv sh

if [ "$ENABLE_NAT" != "true" ]; then
  echo "ENABLE_NAT=$ENABLE_NAT, skipping ip_forward and NAT rules"
  exit 0
fi

echo "Configuring NAT"

# Enable ip forward in the container's network namespace
if [ "$(cat /proc/sys/net/ipv4/ip_forward)" = "1" ]; then
  echo "ip_forward already enabled"
elif [ -w /proc/sys/net/ipv4/ip_forward ]; then
  echo 1 > /proc/sys/net/ipv4/ip_forward
  echo "ip_forward enabled for this session ($(cat /proc/sys/net/ipv4/ip_forward))"
else
  echo "Cannot write to /proc/sys/net/ipv4/ip_forward, check container privileges / namespace" >&2
  exit 1
fi

# Enable NAT to let other hosts access the upstream network
# With keepalived, clients reach the gateway through the VMAC interface
lan_ifs="$LAN_IF"
if [ "$ENABLE_KEEPALIVED" = "true" ]; then
  lan_ifs="$lan_ifs vrrp.$KEEPALIVED_VIRTUAL_ROUTER_ID"
fi

echo "installing NAT rules: $lan_ifs (private) -> $WAN_IF (public)"

# Source traffic from WAN_ADDRESS (floating with keepalived) rather than any other WAN_IF address
iptables -t nat -C POSTROUTING -o "$WAN_IF" -j SNAT --to-source "$WAN_ADDRESS" 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o "$WAN_IF" -j SNAT --to-source "$WAN_ADDRESS"

for lan_if in $lan_ifs; do
  iptables -C FORWARD -i "$lan_if" -o "$WAN_IF" -j ACCEPT 2>/dev/null || \
    iptables -A FORWARD -i "$lan_if" -o "$WAN_IF" -j ACCEPT

  iptables -C FORWARD -i "$WAN_IF" -o "$lan_if" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -A FORWARD -i "$WAN_IF" -o "$lan_if" -m state --state RELATED,ESTABLISHED -j ACCEPT
done
