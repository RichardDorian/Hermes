#!/bin/sh

# Called by keepalived with: <INSTANCE|GROUP> <name> <state> <priority>
# dnsmasq and wireguard only run on the node holding the floating addresses
case "$3" in
  MASTER) action=-u ;;
  *) action=-d ;;
esac

for service in dnsmasq wireguard; do
  echo "keepalived entered $3 state, s6-svc $action $service"
  /command/s6-svc "$action" "/run/service/$service"
done
